---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  kicker: string;
  heading: string;
  updated: string;
  path: string;
  toc?: { id: string; label: string }[];
  active?: string;
  ogImage?: string;
}

const {
  title,
  description,
  kicker,
  heading,
  updated,
  path,
  toc = [],
  active = 'recursos',
  ogImage = '/og/recursos.png',
} = Astro.props;
---

<Base
  title={title}
  description={description}
  active={active}
  path={path}
  ogImage={ogImage}
>
  <section class="doc-head">
    <div class="wrap">
      <p class="kicker">{kicker}</p>
      <h1>{heading}</h1>
      <p class="updated">Actualizado el {updated}</p>
    </div>
  </section>

  <section class="doc-body">
    <div class="wrap" data-toc={toc.length > 0}>
      {
        toc.length > 0 && (
          <nav class="toc" aria-label="En esta página">
            <p class="toc-title">En esta página</p>
            {toc.map((t) => (
              <a href={`#${t.id}`}>{t.label}</a>
            ))}
          </nav>
        )
      }
      <div class="prose">
        <slot />
      </div>
    </div>
  </section>
</Base>

<style>
  .doc-head {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .doc-head .wrap {
    padding-block: 56px 40px;
  }
  .kicker {
    font-size: 13px;
    color: var(--ink-soft);
  }
  h1 {
    font-size: 42px;
    letter-spacing: -0.03em;
    margin-top: 10px;
    max-width: 760px;
    line-height: 1.1;
  }
  .updated {
    font-size: 12.5px;
    color: var(--ink-faint);
    margin-top: 14px;
  }

  .doc-body {
    background: var(--paper);
  }
  .doc-body .wrap {
    padding-block: 52px 80px;
  }
  .doc-body .wrap[data-toc='true'] {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 56px;
  }
  .toc {
    align-self: start;
    position: sticky;
    top: 80px;
  }
  .toc-title {
    font-size: 11px;
    font-weight: 700;
    color: var(--ink-faint);
    margin-bottom: 12px;
  }
  .toc a {
    display: block;
    font-size: 13px;
    color: var(--ink-soft);
    padding: 5px 0;
  }
  .toc a:hover {
    color: var(--aqua);
  }

  .prose {
    max-width: 720px;
  }

  @media (max-width: 860px) {
    h1 {
      font-size: 30px;
    }
    .doc-body .wrap[data-toc='true'] {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .toc {
      display: none;
    }
  }
</style>

<style is:global>
  .prose h2 {
    font-size: 20px;
    letter-spacing: -0.02em;
    margin: 36px 0 12px;
  }
  .prose h2:first-child {
    margin-top: 0;
  }
  .prose h2[id] {
    scroll-margin-top: 90px;
  }
  .prose p {
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--ink-soft);
    margin: 0 0 14px;
  }
  .prose ul {
    margin: 0 0 14px;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .prose li {
    font-size: 14px;
    line-height: 1.65;
    color: var(--ink-soft);
  }
  .prose b,
  .prose strong {
    color: var(--ink);
    font-weight: 600;
  }
  .prose a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose .note {
    background: var(--mint-soft);
    border-left: 3px solid var(--aqua);
    border-radius: 0 10px 10px 0;
    padding: 14px 18px;
    margin: 20px 0;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--aqua-deep);
  }
  .prose .warn {
    background: var(--warn-bg);
    border-left: 3px solid var(--warn);
    border-radius: 0 10px 10px 0;
    padding: 14px 18px;
    margin: 20px 0;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--warn);
  }
  .prose .source {
    font-size: 12px;
    color: var(--ink-faint);
    margin: 22px 0 0;
    line-height: 1.6;
  }
  .prose .cta-row {
    margin-top: 24px;
  }
</style>
