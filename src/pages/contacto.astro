---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base
  title="Contacto"
  description="El soporte de FiscoRD se atiende por correo en soporte@fiscord.lat, en días hábiles, normalmente dentro de las 24 horas."
  active={undefined}
  path="/contacto"
>
  <section class="contact">
    <div class="wrap grid">
      <div class="info">
        <h1>Contacto</h1>
        <p class="lede">
          El soporte de FiscoRD se atiende por correo. Escríbenos con tu consulta
          y el RNC de tu empresa y te respondemos en días hábiles, normalmente
          dentro de las 24 horas.
        </p>

        <a href="mailto:soporte@fiscord.lat" class="mail-link">
          <Icon name="mail" size={16} color="var(--aqua)" />
          <span>soporte@fiscord.lat</span>
        </a>

        <p class="note">
          Para ventas y planes Empresarial, indícalo en el asunto y lo derivamos
          al equipo comercial.
        </p>
        <p class="note soft">
          ¿Ya tienes cuenta? Desde la app, en Ajustes · Centro de ayuda, escribes
          con tu empresa ya identificada.
        </p>
      </div>

      <form class="card form" id="contact-form" action="mailto:soporte@fiscord.lat" method="post" enctype="text/plain">
        <label>
          <span>Nombre</span>
          <input type="text" name="nombre" placeholder="Tu nombre" autocomplete="name" required />
        </label>
        <label>
          <span>Correo</span>
          <input type="email" name="correo" placeholder="tu@empresa.com" autocomplete="email" required />
        </label>
        <label>
          <span>¿En qué te ayudamos?</span>
          <textarea name="mensaje" rows="4" placeholder="Cuéntanos…" required></textarea>
        </label>
        <button type="submit" class="send">Enviar mensaje</button>
        <p class="hint" id="contact-hint" hidden>
          Se abrió tu aplicación de correo con el mensaje listo. Si no se abrió, escríbenos a
          <a href="mailto:soporte@fiscord.lat">soporte@fiscord.lat</a>.
        </p>
      </form>
    </div>
  </section>
</Base>

<script>
  // Sin servidor de formularios: el mensaje se compone y se abre en el correo de la persona.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const nombre = String(d.get('nombre') ?? '').trim();
    const correo = String(d.get('correo') ?? '').trim();
    const mensaje = String(d.get('mensaje') ?? '').trim();
    const asunto = `Consulta FiscoRD — ${nombre}`;
    const cuerpo = `${mensaje}\n\n—\n${nombre}\n${correo}`;
    window.location.href = `mailto:soporte@fiscord.lat?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(cuerpo)}`;
    const hint = document.getElementById('contact-hint');
    if (hint) hint.hidden = false;
  });
</script>

<style>
  .contact .wrap {
    padding-block: 84px 100px;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 420px);
    gap: 56px;
    align-items: start;
    max-width: 1000px;
  }
  h1 {
    font-size: 40px;
    letter-spacing: -0.03em;
  }
  .lede {
    font-size: 16px;
    color: var(--ink-soft);
    line-height: 1.65;
    margin-top: 16px;
    max-width: 460px;
  }
  .mail-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    font-size: 14px;
    font-weight: 600;
    color: var(--aqua);
  }
  .note {
    font-size: 13px;
    color: var(--ink-soft);
    margin-top: 14px;
    line-height: 1.6;
    max-width: 440px;
  }
  .note.soft {
    opacity: 0.8;
  }
  .form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
  }
  .form label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .form input,
  .form textarea {
    font: inherit;
    font-size: 14px;
    font-weight: 400;
    color: var(--ink);
    background: var(--paper, #f4f8f7);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 11px 13px;
    resize: vertical;
  }
  .form input:focus,
  .form textarea:focus {
    outline: 2px solid color-mix(in srgb, var(--aqua) 55%, transparent);
    outline-offset: 1px;
    border-color: var(--aqua);
  }
  .send {
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    background: var(--aqua);
    border: 0;
    border-radius: 10px;
    padding: 12px 16px;
    cursor: pointer;
  }
  .send:hover {
    filter: brightness(0.95);
  }
  .hint {
    font-size: 12px;
    color: var(--ink-soft);
    line-height: 1.55;
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
