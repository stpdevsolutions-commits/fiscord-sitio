---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---

<Base
  title="Página no encontrada"
  description="La página que buscas no existe o cambió de dirección."
  active={undefined}
  path="/404"
>
  <section class="nf">
    <div class="wrap">
      <p class="code fiscal">404</p>
      <h1>Esta página no existe</h1>
      <p class="blurb">
        Puede que el enlace esté roto o que la página haya cambiado de dirección.
      </p>
      <div class="cta">
        <Button href="/">Ir al inicio</Button>
        <Button href="/recursos" variant="ghost">Ver recursos</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf .wrap {
    max-width: 640px;
    padding-block: 100px 120px;
  }
  .code {
    font-size: 15px;
    color: var(--ink-faint);
    letter-spacing: 0.1em;
  }
  h1 {
    font-size: 36px;
    letter-spacing: -0.03em;
    margin-top: 8px;
  }
  .blurb {
    font-size: 16px;
    color: var(--ink-soft);
    margin-top: 14px;
    line-height: 1.6;
  }
  .cta {
    display: flex;
    gap: 12px;
    margin-top: 26px;
    flex-wrap: wrap;
  }
</style>
