---
interface Props {
  href: string;
  variant?: 'solid' | 'ghost';
  size?: 'md' | 'sm';
  class?: string;
}
const { href, variant = 'solid', size = 'md', class: klass = '' } = Astro.props;
const external = /^https?:\/\//.test(href);
---

<a
  href={href}
  class:list={['btn', variant, size, klass]}
  {...(external ? { rel: 'noopener', target: '_blank' } : {})}
>
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--body);
    font-weight: 600;
    border-radius: var(--r-md);
    transition:
      transform 0.1s ease,
      box-shadow 0.2s ease,
      background 0.15s ease;
    white-space: nowrap;
  }
  .btn:active {
    transform: translateY(1px);
  }
  .btn.md {
    font-size: 14.5px;
    padding: 13px 22px;
  }
  .btn.sm {
    font-size: 13px;
    padding: 9px 15px;
  }
  .btn.solid {
    background: var(--aqua);
    color: #fff;
    box-shadow: 0 12px 24px -12px rgba(11, 118, 132, 0.55);
  }
  .btn.solid:hover {
    background: var(--aqua-deep);
    color: #fff;
  }
  .btn.ghost {
    background: var(--surface);
    color: var(--ink-soft);
    border: 1px solid var(--line);
  }
  .btn.ghost:hover {
    color: var(--ink);
    border-color: var(--ink-faint);
  }
</style>
