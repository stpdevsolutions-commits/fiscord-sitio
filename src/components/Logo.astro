---
// Marca FiscoRD: la "F" deconstruida (favicon.svg de la app) + wordmark.
interface Props {
  size?: number;
  /** tamaño de la palabra "FiscoRD"; 0 = solo el símbolo */
  word?: number;
}
const { size = 30, word = 19 } = Astro.props;
---

<span style="display:inline-flex;align-items:center;gap:10px;">
  <svg width={size} height={size} viewBox="0 0 512 512" style="flex-shrink:0;display:block;" aria-hidden="true">
    <defs>
      <linearGradient id="fx-aqua" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#0B7684"></stop>
        <stop offset="1" stop-color="#085362"></stop>
      </linearGradient>
    </defs>
    <rect width="512" height="512" rx="116" fill="url(#fx-aqua)"></rect>
    <g fill="#F4F8F7" transform="translate(106 106) scale(3)">
      <rect x="27" y="22" width="47" height="14" rx="7"></rect>
      <rect x="27" y="43" width="31" height="14" rx="7"></rect>
      <rect x="63.5" y="43" width="14" height="31" rx="7" transform="rotate(12 70.5 58.5)"></rect>
      <rect x="29" y="63" width="14" height="31" rx="7" transform="rotate(12 36 78.5)"></rect>
    </g>
  </svg>
  {word > 0 && (
    <span style={`font-family:var(--display);font-weight:800;font-size:${word}px;letter-spacing:-0.03em;`}>
      Fisco<span style="color:var(--aqua);">RD</span>
    </span>
  )}
</span>
